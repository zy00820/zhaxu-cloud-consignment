# ===== 栈序云寄售 后端配置 =====

# 服务端口
PORT=3000

# 前端地址（支付宝同步跳转用）
FRONTEND_URL=https://zy00820.github.io/zhaxu-cloud-consignment

# 是否允许模拟支付（未配置真实支付时降级为模拟，设为 false 关闭）
ALLOW_MOCK=true

# ===== 支付宝支付 =====
# 前往 https://open.alipay.com 申请应用，获取以下信息
ALIPAY_APP_ID=你的支付宝应用ID
ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
你的应用私钥（PKCS1 或 PKCS8）
-----END RSA PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
支付宝公钥
-----END PUBLIC KEY-----
# 正式环境：https://openapi.alipay.com/gateway.do   沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=https://你的后端域名/api/pay/alipay/notify
ALIPAY_RETURN_URL=https://你的后端域名/api/pay/alipay/return

# ===== 微信支付 =====
# 前往 https://pay.weixin.qq.com 申请商户号
WX_APPID=你的微信公众号/小程序AppID
WX_MCHID=你的微信支付商户号
WX_APIKEY=你的微信支付API密钥
WX_NOTIFY_URL=https://你的后端域名/api/pay/wechat/notify
